{"name":"DoTrapAttack","permission":{"default":0,"devnIbfBHb74U9Zv":3},"type":"script","flags":{},"scope":"global","command":"// Requires minor-qol to work completely\r\n// Rolls an attack from actor args[0] using item args[1] and display a token args[2]\r\nlet tactor = game.actors.entities.find(a => a.name === args[0])\r\nif (!tactor) return `/Whisper GM \"DoTrap: Target token ${args[0]} not found\"`\r\nlet item = tactor.items.find(i=>  i.name === args[1])\r\nif (!item) return `/Whisper GM \"DoTrap: Item ${args[1]} not found\"`\r\nlet oldTargets = game.user.targets;\r\ngame.user.targets = new Set();\r\ngame.user.targets.add(token);\r\nitem.rollAttack({event: {shiftKey: true}})\r\nlet trapToken = canvas.tokens.placeables.find(t=>t.name === args[2])\r\nif (trapToken) await DynamicEffects.setTokenVisibility(trapToken.id, true);\r\ngame.user.targets = oldTargets;\r\n\r\n// sample trigger happy line\r\n// @Token[Trap1] @Trigger[capture move] @ChatMessage[/DoTrapAttack TrapEffects \"Scything Blade\" Trap1]\r\n// requires a token on the map called Trap1\r\n// An actor called TrapEffects (does not need to be on the map)\r\n// The actor TrapEffects needs a weapon called \"Scything Blade\"\r\n// If using minor-qol the damage will be auto applied","author":"devnIbfBHb74U9Zv","img":"icons/svg/dice-target.svg","actorIds":[],"_id":"4CR9UT7eEIHMDnTi"}
{"name":"Sneak Attack - passive","permission":{"default":0},"type":"script","sort":100001,"flags":{},"scope":"global","command":"DynamicEffects.setPassive(\"Sneak Attack\", true, \"feat\")","author":"devnIbfBHb74U9Zv","img":"systems/dnd5e/icons/skills/blood_02.jpg","actorIds":[],"_id":"820gffwpcfLMYABD"}
{"name":"Whisper","permission":{"default":0,"devnIbfBHb74U9Zv":3},"type":"script","flags":{},"scope":"global","command":"ChatMessage.create({\r\n    content: args[0],\r\n    whisper: ChatMessage.getWhisperIDs(\"GM\")\r\n})","author":"devnIbfBHb74U9Zv","img":"icons/svg/dice-target.svg","actorIds":[],"_id":"IJDEUyvtXOG6dPGK"}
{"name":"Divine Smite","permission":{"default":0,"devnIbfBHb74U9Zv":3},"type":"script","flags":{"furnace":{"gmexecute":true,"runAsGM":false},"combat-utility-belt":{"macroTrigger":""}},"scope":"global","command":"if (args[0] === \"on\") {\r\nlet target = canvas.tokens.get(args[1])\r\nlet numDice = 1 + (Number(args[2]) || 1)\r\nif (target.actor.data.data.details.type === \"Undead\") numDice += 1;\r\nnew Roll(`${numDice}d8`).roll().toMessage({flavor: \"Divine Smite - Damage Roll (Radiant)\", speaker, flags: {noDynamicEffects: true}})\r\n}","author":"devnIbfBHb74U9Zv","img":"systems/dnd5e/icons/spells/beam-red-2.jpg","actorIds":[],"_id":"KukwXWvSediF4abJ"}
{"_id":"UJMjmx9B4tmWhEG4","name":"Bless - apply","permission":{"default":0},"type":"script","sort":100001,"flags":{"dnd5e":{"itemMacro":true}},"scope":"global","command":"DynamicEffects.applyActive(\"Bless\", true, \"spell\")","author":"devnIbfBHb74U9Zv","img":"systems/dnd5e/icons/spells/haste-sky-1.jpg","actorIds":[]}
{"name":"Activate Effects","permission":{"default":0},"type":"script","sort":100001,"flags":{},"scope":"global","command":"DynamicEffects.activateItem()","author":"devnIbfBHb74U9Zv","img":"icons/svg/dice-target.svg","actorIds":[],"_id":"YYA2IkpY2aU1died"}
{"_id":"f7DXJR54xp43gNRk","name":"Show Active Effects","permission":{"default":0},"type":"script","sort":2200000,"flags":{},"scope":"global","command":"DynamicEffects.effects(true)\r\n","author":"devnIbfBHb74U9Zv","img":"icons/svg/dice-target.svg","actorIds":[]}
{"_id":"fg4uJLZc82lgiTuj","name":"remove all effects","permission":{"default":0},"type":"script","sort":100001,"flags":{},"scope":"global","command":"DynamicEffects.removeAllActiveffects()\r\n","author":"devnIbfBHb74U9Zv","img":"icons/svg/dice-target.svg","actorIds":[]}
{"name":"Aid","permission":{"default":0,"devnIbfBHb74U9Zv":3},"type":"script","flags":{"combat-utility-belt":{"macroTrigger":""},"furnace":{"runAsGM":true}},"scope":"global","command":"let target = canvas.tokens.get(args[1]);\r\nif (!target) {\r\n  ChatMessage.create({content: `Token ${args[1]} is no longer in scene`, whisper: ChatMessage.getWhisperIDs(\"GM\")})\r\n  return;\r\n}\r\n\r\nlet increment = 5 * (args[2] - 1);\r\nif (!args[2]) increment = 5;\r\nlet hpMax = target.actor.data.data.attributes.hp.max;\r\nlet hp = target.actor.data.data.attributes.hp.value;\r\n\r\nif (args[0] === \"on\") {\r\n  target.actor.update({\"data.attributes.hp.max\": hpMax + increment, \"data.attributes.hp.value\": hp + increment})\r\nChatMessage.create({content: `Aid Spell: ${target.name} received ${increment} HP`})\r\n} else {\r\n  target.actor.update({\"data.attributes.hp.max\": hpMax - increment, \"data.attributes.hp.value\": Math.min(hp, hpMax - increment)})\r\nChatMessage.create({content: `Aid Spell Expiry: ${target.name} Max HP reduced by ${increment}`})\r\n}\r\n","author":"devnIbfBHb74U9Zv","img":"icons/svg/dice-target.svg","actorIds":[],"_id":"gVTMTz5AiqiqVecO"}
{"_id":"m5q6J4KoaUCvxze2","name":"Sneak Attack - off","permission":{"default":0},"type":"script","sort":100001,"flags":{"dnd5e":{"itemMacro":true}},"scope":"global","command":"DynamicEffects.applyActive(\"Sneak Attack\", false, \"feat\")","author":"devnIbfBHb74U9Zv","img":"systems/dnd5e/icons/skills/blood_02.jpg","actorIds":[]}
{"name":"Invisible","permission":{"default":0,"devnIbfBHb74U9Zv":3},"type":"script","flags":{"furnace":{"gmexecute":true,"runAsGM":false},"combat-utility-belt":{"macroTrigger":""}},"scope":"global","command":"//#args 0=tokenId 1 = sceneId\r\nlet hide = args[0] === \"on\";\r\nscene.updateEmbeddedEntity(\"Token\", {\"_id\": args[1], \"hidden\": hide})","author":"devnIbfBHb74U9Zv","img":"icons/svg/dice-target.svg","actorIds":[],"_id":"oWh4uTrugSY4uEdi"}
{"_id":"pdktmNHA9razjdY4","name":"Sneak Attack - minor-qol","permission":{"default":0},"type":"script","sort":100001,"flags":{"dnd5e":{"itemMacro":true}},"scope":"global","command":"// Use minor-qol to roll the feat and apply the active effects\r\nMinorQOL.doRoll(event, \"Sneak Attack\", {type: \"feat\"});","author":"devnIbfBHb74U9Zv","img":"systems/dnd5e/icons/skills/blood_02.jpg","actorIds":[]}
{"name":"Bless - minor-qol","permission":{"default":0},"type":"script","sort":100001,"flags":{"dnd5e":{"itemMacro":true}},"scope":"global","command":"MinorQOL.doRoll(event, \"Bless\", {type: \"spell\"});","author":"devnIbfBHb74U9Zv","img":"systems/dnd5e/icons/spells/haste-sky-1.jpg","actorIds":[],"_id":"phTLzAiWRrtsCYim"}
{"_id":"vmKgYRaEckf0uEWh","name":"Sneak Attack - on","permission":{"default":0},"type":"script","sort":100001,"flags":{"dnd5e":{"itemMacro":true}},"scope":"global","command":"// Turn on the sneak attack feats active effects\r\nDynamicEffects.applyActive(\"Sneak Attack\", true, \"feat\")","author":"devnIbfBHb74U9Zv","img":"systems/dnd5e/icons/skills/blood_02.jpg","actorIds":[]}
{"name":"TeleportToToken","permission":{"default":0},"type":"script","sort":100001,"flags":{},"scope":"global","command":"// Teleport the selected token to named target token.\r\n// The target token can be on a different scene.\r\n// Designed to work with trigger happy.\r\n// Activatae from the chat window with\r\n// /TeleportToToken MyTargetToken 0 0\r\nconsole.log(\"Teleport to token called\", args[0], args[1], args[2]);\r\nDynamicEffects.teleportToToken(token, args[0], args[1], args[2])","author":"devnIbfBHb74U9Zv","img":"icons/svg/dice-target.svg","actorIds":[],"_id":"xuE9JiWntRzjeBBr"}
{"_id":"4CR9UT7eEIHMDnTi","name":"DoTrapAttack","permission":{"default":0,"devnIbfBHb74U9Zv":3},"type":"script","flags":{"combat-utility-belt":{"macroTrigger":""},"furnace":{"runAsGM":false}},"scope":"global","command":"// Requires minor-qol to work completely\r\n// Rolls an attack from actor args[0] using item args[1] and display a token args[2]\r\nlet tactor = game.actors.entities.find(a => a.name === args[0])\r\nif (!tactor) return `/Whisper GM \"DoTrap: Target token ${args[0]} not found\"`\r\nlet item = tactor.items.find(i=>  i.name === args[1])\r\nif (!item) return `/Whisper GM \"DoTrap: Item ${args[1]} not found\"`\r\nlet oldTargets = game.user.targets;\r\ngame.user.targets = new Set();\r\ngame.user.targets.add(token);\r\nHooks.once(\"MinorQolRollComplete\", () => {\r\nChatMessage.create({content: \"restoring targets\"});\r\nMinorQOL.forceRollDamage=false;\r\ngame.user.targets=oldTargets;\r\n})\r\nMinorQOL.forceRollDamage = true;\r\nawait MinorQOL.doCombinedRoll({actor, item, event, token})\r\nlet trapToken = canvas.tokens.placeables.find(t=>t.name === args[2])\r\nif (trapToken) await DynamicEffects.setTokenVisibility(trapToken.id, true);\r\n\r\n// sample trigger happy line\r\n// @Token[Trap1] @Trigger[capture move] @ChatMessage[/DoTrapAttack TrapEffects \"Scything Blade\" Trap1]\r\n// requires a token on the map called Trap1\r\n// An actor called TrapEffects (does not need to be on the map)\r\n// The actor TrapEffects needs a weapon called \"Scything Blade\"\r\n// If using minor-qol the damage will be auto applied","author":"devnIbfBHb74U9Zv","img":"icons/svg/dice-target.svg","actorIds":[]}
{"_id":"gVTMTz5AiqiqVecO","name":"Aid","permission":{"default":0,"devnIbfBHb74U9Zv":3},"type":"script","flags":{"combat-utility-belt":{"macroTrigger":""},"furnace":{"runAsGM":true}},"scope":"global","command":"let target = canvas.tokens.get(args[1]);\r\nif (!target) {\r\n  ChatMessage.create({content: `Token ${args[1]} is no longer in scene`, whisper: ChatMessage.getWhisperIDs(\"GM\")})\r\n  return;\r\n}\r\n\r\nlet increment = 5 * (args[2] - 1);\r\nif (!args[2]) increment = 5;\r\nlet hpMax = target.actor.data.data.attributes.hp.max;\r\nlet hp = target.actor.data.data.attributes.hp.value;\r\n\r\nif (args[0] === \"on\") {\r\n  target.actor.update({\"data.attributes.hp.max\": hpMax + increment, \"data.attributes.hp.value\": hp + increment})\r\nChatMessage.create({content: `Aid Spell: ${target.name} received ${increment} HP`})\r\n} else {\r\n  target.actor.update({\"data.attributes.hp.max\": hpMax - increment, \"data.attributes.hp.value\": Math.min(hp, hpMax - increment)})\r\nChatMessage.create({content: `Aid Spell Expiry: ${target.name} Max HP reduced by ${increment}`})\r\n}\r\n// Run as an active effect on the Aid spell via macro.execute = @target @spellLevel\r\n","author":"devnIbfBHb74U9Zv","img":"icons/svg/dice-target.svg","actorIds":[]}
{"_id":"KukwXWvSediF4abJ","name":"Divine Smite","permission":{"default":0,"devnIbfBHb74U9Zv":3},"type":"script","flags":{"furnace":{"gmexecute":true,"runAsGM":false},"combat-utility-belt":{"macroTrigger":""}},"scope":"global","command":"if (args[0] === \"on\") {\r\nlet target = canvas.tokens.get(args[1])\r\nlet numDice = 1 + (Number(args[2]) || 1)\r\nif (target.actor.data.data.details.type === \"Undead\") numDice += 1;\r\nnew Roll(`${numDice}d8`).roll().toMessage({flavor: \"Divine Smite - Damage Roll (Radiant)\", speaker, flags: {noDynamicEffects: true}})\r\n}\r\n// To use this create a spell called Divine Smite and set its active effect to be\r\n// macro.execute = \"Divine Smite\" @target @spellLevel\r\n// assuming minor-qol is running casting the spell will cause the damage to be rolled and applied to the targeted token.","author":"devnIbfBHb74U9Zv","img":"systems/dnd5e/icons/spells/beam-red-2.jpg","actorIds":[]}
{"_id":"oWh4uTrugSY4uEdi","name":"Invisible","permission":{"default":0,"devnIbfBHb74U9Zv":3},"type":"script","flags":{"furnace":{"gmexecute":true,"runAsGM":true},"combat-utility-belt":{"macroTrigger":""}},"scope":"global","command":"//#args 0=tokenId 1 = sceneId\r\nlet hide = args[0] === \"on\";\r\nscene.updateEmbeddedEntity(\"Token\", {\"_id\": args[1], \"hidden\": hide})","author":"devnIbfBHb74U9Zv","img":"icons/svg/dice-target.svg","actorIds":[]}
{"_id":"f7DXJR54xp43gNRk","name":"Show Active/Passive Effects","permission":{"default":0},"type":"script","sort":2200000,"flags":{"combat-utility-belt":{"macroTrigger":""},"furnace":{"runAsGM":false}},"scope":"global","command":"DynamicEffects.effects(true)\r\n","author":"devnIbfBHb74U9Zv","img":"icons/svg/dice-target.svg","actorIds":[]}
{"_id":"xuE9JiWntRzjeBBr","name":"TeleportToToken","permission":{"default":0},"type":"script","sort":100001,"flags":{"combat-utility-belt":{"macroTrigger":""},"furnace":{"runAsGM":false}},"scope":"global","command":"let targetScene;\r\nif (!token) return ChatMessage.create({content: `No token selected`})\r\nfor (let scene of game.scenes.entities) {\r\n  var targetToken = scene.data.tokens.find(t => t.name === args[0]);\r\n  if (targetToken) {\r\n   targetScene = scene;\r\n   break;\r\n  }\r\n}\r\nif (!targetScene) return ChatMessage.create({content: `Could not find token ${args[0]} in any scene`});\r\nCanvasAnimation.terminateAnimation(`Token.${token.id}.animateMovement`);\r\n\r\nlet x = targetToken.x + targetScene.data.grid * (args[1] || 0);\r\nlet y = targetToken.y + targetScene.data.grid * (args[2] || 0);\r\nlet startScene = canvas.scene.id;\r\n\r\nawait game.macros.getName(\"createToken\")?.execute(targetScene.id, x, y, token.data)\r\nif(targetScene.id === startScene) {\r\n  await game.macros.getName(\"deleteToken\")?.execute(startScene, token.id)\r\n} else {\r\n  Hooks.once(\"canvasReady\", () => {\r\n    game.macros.getName(\"deleteToken\")?.execute(startScene, token.id)\r\n  })\r\n  await targetScene.view();\r\n}\r\ncanvas.pan(x,y)\r\n","author":"devnIbfBHb74U9Zv","img":"icons/svg/dice-target.svg","actorIds":[]}
{"name":"createToken","permission":{"default":0,"devnIbfBHb74U9Zv":3},"type":"script","flags":{"combat-utility-belt":{"macroTrigger":""},"furnace":{"runAsGM":true}},"scope":"global","command":"let targetScene = game.scenes.get(args[0])\r\nif (!targetScene || !args[3]) return;\r\nawait targetScene.createEmbeddedEntity('Token', mergeObject(duplicate(args[3]), { \"x\": args[1] || 0, \"y\": args[2] || 0}, { overwrite: true, inplace: true }));","author":"devnIbfBHb74U9Zv","img":"icons/svg/dice-target.svg","actorIds":[],"_id":"xTQOMuRlZJIE8C6X"}
{"name":"deleteToken","permission":{"default":0,"devnIbfBHb74U9Zv":3},"type":"script","flags":{"combat-utility-belt":{"macroTrigger":""},"furnace":{"runAsGM":true}},"scope":"global","command":"let startScene = game.scenes.get(args[0]);\r\nif (!startScene || !args[1]) return;\r\nawait startScene.deleteEmbeddedEntity(\"Token\", args[1]);","author":"devnIbfBHb74U9Zv","img":"icons/svg/dice-target.svg","actorIds":[],"_id":"b7arWwNLWNoQaVBD"}
{"_id":"xuE9JiWntRzjeBBr","name":"TeleportToToken","permission":{"default":0},"type":"script","sort":100001,"flags":{"combat-utility-belt":{"macroTrigger":""},"furnace":{"runAsGM":false}},"scope":"global","command":"let targetScene;\r\nif (!token) return ChatMessage.create({content: `No token selected`})\r\nfor (let scene of game.scenes.entities) {\r\n  var targetToken = scene.data.tokens.find(t => t.name === args[0]);\r\n  if (targetToken) {\r\n   targetScene = scene;\r\n   break;\r\n  }\r\n}\r\nif (!targetScene) return ChatMessage.create({content: `Could not find token ${args[0]} in any scene`});\r\nCanvasAnimation.terminateAnimation(`Token.${token.id}.animateMovement`);\r\n\r\nlet x = targetToken.x + targetScene.data.grid * (args[1] || 0);\r\nlet y = targetToken.y + targetScene.data.grid * (args[2] || 0);\r\nlet startScene = canvas.scene.id;\r\n\r\nawait game.macros.getName(\"createToken\")?.execute(targetScene.id, x, y, token.data)\r\nif(targetScene.id === startScene) {\r\n  await game.macros.getName(\"deleteToken\")?.execute(startScene, token.id)\r\n} else {\r\n  Hooks.once(\"canvasReady\", () => {\r\n    game.macros.getName(\"deleteToken\")?.execute(startScene, token.id)\r\n  })\r\n  await targetScene.view();\r\n}\r\ncanvas.pan(x,y)\r\n// This macro is intended to be used with Trigger Happy and requires Furnace advanced macros to run.\r\n// Sample trigger happy setup.\r\n// You must place two tokens on some scene(s). They must have unqiue name (not actor name, but token name).\r\n// @Token[Target1] @Trigger[move capture] @ChatMessage[/TeleportToToken Target2 -1 1]\r\n// The sample will, when a player moves their token over the target token \"Target1\", \r\n// delete the players token and recreate it next to the token named Target2\r\n// For the example above the players token will be placed 1 grid unit to the left of Target2 and one grid unit down from Target2\r\n","author":"devnIbfBHb74U9Zv","img":"icons/svg/dice-target.svg","actorIds":[]}
