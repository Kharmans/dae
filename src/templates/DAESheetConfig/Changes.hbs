<section class="tab changes {{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    <header>
        <div class="key">{{localize "EFFECT.FIELDS.changes.element.key.label"}}</div>
        <div class="mode">{{localize "EFFECT.FIELDS.changes.element.type.label"}}</div>
        <div class="value">{{localize "EFFECT.FIELDS.changes.element.value.label"}}</div>
        <div class="priority">{{localize "EFFECT.FIELDS.changes.element.priority.label"}}</div>
        <div class="controls"><a data-action="addChange"><i class="fa-regular fa-plus-square"></i></a></div>
    </header>
    <ol class="scrollable">
        {{#each source.system.changes as |change i|}}
        {{#with @root.changeFields as |changeFields|}}
            <li data-index="{{i}}">
                <div class="key">
                    <div class="form-group key-wrapper">
                        <div class="key">
                            <input class="key-input" type="text" name="system.changes.{{i}}.key" value="{{change.key}}" />
                        </div>
                        <div class="dae-field-info">
                            <div class="dae-field-name">{{change.fieldName}}</div>
                            <div class="dae-field-description">{{change.fieldDescription}}</div>
                        </div>
                    </div>
                </div>
                <div class="mode">
                    <select name="system.changes.{{i}}.type" data-dtype="String">
                        {{#if change.types}}
                            {{selectOptions change.types selected=change.type}}
                        {{else}}
                            {{selectOptions @root.allTypes selected=change.type}}
                        {{/if}}
                    </select>
                </div>
                <div class="value">
                    {{#if change.options}}
                        <select name="system.changes.{{i}}.value" data-dtype="String">
                            {{selectOptions change.options selected=change.value localize=false}}
                        </select>
                    {{else}}
                        <div class="value flex-grow">
                            <textarea name="system.changes.{{i}}.value" rows="1">{{change.value}}</textarea>
                        </div>
                        {{#if change.hasEditor}}
                        <a class="dae-edit-value" data-index="{{i}}" data-tooltip="{{change.editorTooltip}}"><i class="{{change.editorIcon}}"></i></a>
                        {{/if}}
                    {{/if}}
                </div>
                <div class="priority">
                    {{formInput changeFields.priority name=(concat "system.changes." i ".priority") value=change.priority
                        placeholder=(lookup ../../priorities change.type)}}
                </div>
                <div class="controls"><a data-action="deleteChange"><i class="fa-solid fa-trash"></i></a></div>
            </li>
        {{/with}}
        {{/each}}
    </ol>
</section>
