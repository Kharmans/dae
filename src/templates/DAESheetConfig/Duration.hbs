<section class="tab{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">

    {{!-- Effect Start (read-only, matches core v14 pattern) --}}
    {{#if start}}
    <fieldset class="start-data">
        <legend>{{localize "EFFECT.START.Header"}}</legend>
        <div class="form-group">
            <span class="label">{{localize "EFFECT.FIELDS.start.time.label"}}</span>
            <div class="form-fields">
                {{start.time}}
                <button type="button" class="icon" data-action="resetStartTime" data-tooltip="{{localize "dae.resetStartTime"}}">
                    <i class="fas fa-clock-rotate-left"></i>
                </button>
            </div>
        </div>
        {{#if start.combat}}
        <div class="form-group">
            <span class="label">{{localize "DOCUMENT.Combat"}}</span>
            <div class="form-fields">
                {{localize "EFFECT.START.Combat" round=start.round turn=start.turn}}
            </div>
        </div>
        {{#if start.combatant}}
        <div class="form-group">
            <span class="label">{{localize "DOCUMENT.Combatant"}}</span>
            <div class="form-fields">
                {{localize "EFFECT.START.Combatant" combatant=start.combatantName initiative=start.combatantInitiative}}
            </div>
        </div>
        {{/if}}
        {{/if}}
    </fieldset>
    {{/if}}

    {{!-- Effect Duration (matches core v14 pattern + DAE extras) --}}
    <fieldset>
        <legend>{{localize "EFFECT.DURATION.Header"}}</legend>
        <div class="form-group slim duration" data-duration>
            <label class="flexrow" for="{{rootId}}-duration.value">
                <span>{{localize "EFFECT.DURATION.Label"}}</span>
                <span class="warning" hidden><i class="fa-duotone fa-triangle-exclamation"></i></span>
            </label>
            <div class="form-fields">
                {{formInput fields.duration.fields.value value=source.duration.value id=(concat rootId "-duration.value")
                            aria=(object label=(localize "EFFECT.FIELDS.duration.value.label"))}}
                {{formInput fields.duration.fields.units value=source.duration.units id=(concat rootId "-duration.units")
                            options=durationUnits aria=(object label=(localize "EFFECT.FIELDS.duration.units.label"))}}
            </div>
        </div>
        {{formGroup fields.duration.fields.expiry choices=expiryEvents value=source.duration.expiry rootId=rootId}}

        <div class="form-group">
            <label>{{localize "dae.expiryMode.Name"}}</label>
            <div class="form-fields">
                <select name="flags.dae.expiryMode" data-dtype="String">
                    {{selectOptions expiryModeOptions selected=source.flags.dae.expiryMode}}
                </select>
            </div>
            <p class="hint">{{localize "dae.expiryMode.Hint"}}</p>
        </div>

        {{!-- DAE: Duration Expression (item effects only) --}}
        {{#if isItemEffect}}
            <div class="form-group">
                <label>{{ localize "dae.DurationExpression" }}</label>
                <div class="form-fields">
                    <input type="text" name="flags.dae.durationExpression" value="{{ source.flags.dae.durationExpression }}"/>
                </div>
            </div>
        {{/if}}
    </fieldset>

    {{!-- DAE-specific fields --}}
    {{#if (ifThen showSpecialDurations true macroRepeats showCombatActorOverride)}}
    <fieldset>
        <legend>DAE</legend>

        {{!-- Combat Actor Override --}}
        {{#if showCombatActorOverride}}
            <div class="form-group">
                <label>{{localize "dae.combatActorOverride"}}</label>
                <div class="form-fields">
                    <select name="flags.dae.combatActorOverride" data-dtype="String">
                        {{selectOptions combatActorOptions selected=source.flags.dae.combatActorOverride}}
                    </select>
                </div>
            </div>
        {{/if}}

        {{!-- Macro Repeat --}}
        {{#if macroRepeats}}
            <div class="form-group">
                <label>{{localize "dae.macroRepeat"}}</label>
                <div class="form-fields">
                    <select name="flags.dae.macroRepeat" data-dtype="String">
                        {{selectOptions macroRepeats selected=source.flags.dae.macroRepeat}}
                    </select>
                </div>
            </div>
        {{/if}}

        {{!-- Special Durations --}}
        {{#if showSpecialDurations}}
            <div class="dae-special-duration-container">
                <div class="effect-special-duration flexrow">
                    <div class="dae-special-duration-title">
                        {{localize "dae.specialDuration"}}
                    </div>
                    <div class="effect-controls dae-effect-controls">
                        <a class="effect-control dae-effect-control" data-action="addSpecialDuration">
                            <i class="far fa-plus-square"></i>
                        </a>
                    </div>
                </div>
                <ol class="special-duration-list">
                    {{#each source.flags.dae.specialDuration}}
                        <li class="effect-special-duration flexrow" data-index="{{@key}}">
                            <div class="form-group">
                                <select name="flags.dae.specialDuration.{{@key}}" data-dtype="string">
                                    {{selectOptions ../specialDuration selected=this}}
                                </select>
                                <a class="effect-controls effect-control"
                                data-action="deleteSpecialDuration"><i class="fas fa-trash"></i></a>
                            </div>
                        </li>
                    {{/each}}
                </ol>
            </div>
        {{/if}}
    </fieldset>
    {{/if}}
</section>
